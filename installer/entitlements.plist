<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- sqlite-jdbc extracts its bundled libsqlitejdbc.dylib to a temp directory at
         runtime and dlopens it. That library is NOT signed with our Developer ID, so
         library validation under the hardened runtime would reject it. This
         entitlement allows it to load; Apple accepts it for notarization. -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
